{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "strict": true,
    // omit rootDir to allow imports from sibling packages during type‑checking
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "rootDirs": ["src"]
  },
  "include": ["src"]
}