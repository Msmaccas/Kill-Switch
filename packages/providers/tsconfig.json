{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "strict": true,
    // omit rootDir so that referenced source files outside the package can be type‑checked
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "rootDirs": ["src", "../core/src"]
  },
  "include": ["src"]
}